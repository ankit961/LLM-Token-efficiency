# Generated analysis output — contains real local file paths / project names. NEVER commit.
reports/
reports_test/
**/reports/
**/reports_test/

# Design-doc PDFs (business strategy) — held out of the public repo by default.
*.pdf
!papers/figures/*.pdf
!papers/dist/*.pdf

# LaTeX build intermediates (stable paper PDFs live in papers/dist/).
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# local databases / caches
*.db
*.sqlite
.pytest_cache/

# ContextRuntime local install (`contextruntime install claude`) — local dev state, not source
.claude/
.mcp.json

# Local backup of raw experiment journals (moved off /tmp for durability; large binary sqlite +
# potentially contains local file paths in patches/logs — never commit). See docs/HANDOVER-*.md.
.local-data/
